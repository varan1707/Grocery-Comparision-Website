# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored: NEVER commit real keys. Only this placeholder file is tracked.

# --- Kroger Public API (https://developer.kroger.com) ---
# Register an app with the "Product" and "Location" APIs, then paste its credentials.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# --- Walmart.io Affiliate API (https://walmart.io) ---
# Consumer ID is shown after you upload your RSA public key.
WALMART_CONSUMER_ID=
# Key version shown next to the uploaded key (usually 1).
WALMART_KEY_VERSION=1
# Path to your PKCS#8 private key file, kept OUTSIDE this repo (e.g. ~/.secrets/WM_IO_private_key.pem).
WALMART_PRIVATE_KEY_PATH=
# Alternatively (e.g. on a hosting provider), put the key itself in an env var / secret:
# WALMART_PRIVATE_KEY="<full contents of WM_IO_private_key.pem, with newlines written as \n>"
# Optional: Impact Radius publisher id for affiliate tracking links.
WALMART_PUBLISHER_ID=

# --- App settings ---
# ZIP used for Kroger store pricing when the user does not enter one (optional).
DEFAULT_ZIP_CODE=
# Show clearly-labelled fake prices for stores without keys (local UI work only).
USE_MOCK_DATA=false
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO
